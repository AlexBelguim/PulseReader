# PulseReader: copy to .env and edit. .env is gitignored; never commit it.

# The first admin account, created on first start. After that, accounts are
# managed in the app (Sync -> Users) and these are ignored, so changing them
# later does not change anyone's password. Generate a password with:
#   openssl rand -base64 18
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Host port the web app is served on.
PORT=3000

# Where your epub folders and the database live on the host.
BOOKS_PATH=./books
DATA_PATH=./data

# --- Optional --------------------------------------------------------------

# A key for scripts and tools: send it as "X-API-Key: <key>" and requests act
# as the first admin. Servers from before accounts existed used this as the
# shared password; if ADMIN_PASSWORD is empty, it becomes the admin password.
# API_KEY=

# Only needed if a separately hosted copy of the web app (another origin)
# talks to this server. Comma-separated origins.
# CORS_ORIGIN=https://reader.example.com

# Which proxies to trust for the client IP and HTTPS detection. The default
# trusts loopback and private (LAN / Docker) addresses only.
# TRUST_PROXY=loopback, uniquelocal
